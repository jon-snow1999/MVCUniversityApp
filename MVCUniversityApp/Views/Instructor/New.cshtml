@{
}

<form action="http://localhost:5195/instructor/Add" method="post">
    <div>
        <label>Name</label>
        <input type="text" name="Name" placeholder="Abcde..." class="form form-control">
    </div>
    <div>
        <label>ImageUrl</label>
        <input type="text" name="ImageUrl" placeholder="Abcde..." class="form form-control">
    </div>
    <div>
        <label>Salary</label>
        <input type="number" name="Salary" placeholder="123" class="form form-control">
    </div>
    <div>
        <label>Address</label>
        <input type="text" name="Address" placeholder="ABCDE..." class="form form-control">
    </div>
    <div>
        <label>Department ID</label>
        <input type="number" name="DepartmentId" placeholder="123..." class="form form-control">
    </div>
    <div>
        <input type="submit" name="submitButton" value="Add" class="btn btn-primary">
    </div>
</form>