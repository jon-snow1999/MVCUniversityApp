@{
}
@model Course;

<h1>Deleting @Model.Name</h1>
<h2>Are you sure you wish to delete the above course</h2>
<form action="/course/deletecourse?id=@Model.Id" method="post" class="form form-control">
    <label for="yesdeleteradio">Yes</label>
    <input type="radio" name="shoulddelete" value="y" id="yesdeleteradio" />
    <label for="nodeleteradio">No</label>
    <input type="radio" name="shoulddelete" value="n" id="nodeleteradio" />
    <input type="submit" value="submit" class="btn btn-primary"/>
</form>
